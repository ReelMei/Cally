PORT=2000
# Comma separated list of client URLs allowed by CORS / Socket.IO
ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxx

# Self-hosted Coturn (turnserver.conf: use-auth-secret + static-auth-secret=<TURN_SHARED_SECRET>)
TURN_SERVER_HOST=turn.example.com
TURN_SHARED_SECRET=change-me
# TURN_PORT=3478
# Set only if Coturn has a TLS cert configured (tls-listening-port)
# TURN_TLS_PORT=5349
# TURN_CREDENTIAL_TTL_SECONDS=43200
